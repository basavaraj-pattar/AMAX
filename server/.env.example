PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/a-max
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
CLIENT_URL=http://localhost:5174
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
YOUTUBE_API_KEY=your-youtube-data-api-key
SHOWCASE_TRAILER_LIMIT=3
SHOWCASE_TRAILER_LOOKBACK_DAYS=45
# Optional additional trusted channel titles; separate entries with |.
# SHOWCASE_OFFICIAL_CHANNELS=Regional Studio One|Regional Studio Two
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=AMAX <no-reply@example.com>

# Admin panel — run: node src/scripts/setup-admin.js  (one time only)
ADMIN_USERNAME=MG Admin
ADMIN_DISPLAY_NAME=MG Admin
ADMIN_INITIAL_PASSWORD=your-secure-initial-admin-password
# Optional: separate JWT secret for admin tokens (recommended in production)
# ADMIN_JWT_SECRET=replace-with-a-different-random-secret-at-least-32-characters
